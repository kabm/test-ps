{
  "name": "lumen-studio",
  "productName": "Lumen Studio",
  "version": "1.0.0",
  "description": "Photo editor for Windows: Lightroom-style library & develop + Photoshop-style layers & tools",
  "main": "electron/main.js",
  "author": "Lumen Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/unit/*.test.mjs",
    "test:ui": "npm run build:renderer && node test/ui/run-ui-tests.mjs",
    "dist:win": "npm run build:renderer && electron-builder --win --x64",
    "dist:dir": "npm run build:renderer && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "resedit": "^3.1.0",
    "utif": "^3.1.0"
  },
  "homepage": "https://github.com/kabm/test-ps",
  "build": {
    "appId": "com.lumenstudio.app",
    "productName": "Lumen Studio",
    "copyright": "Copyright (c) 2026 Lumen Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/index.html",
      "src/styles.css",
      "src/bundle/app.js",
      "src/assets/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "LumenStudio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Lumen Studio",
      "artifactName": "Lumen-Studio-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "lumen",
        "name": "LumenProject",
        "description": "Lumen Studio Project",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "tif",
          "tiff",
          "dng",
          "cr2",
          "cr3",
          "nef",
          "arw",
          "raf",
          "orf",
          "rw2",
          "heic",
          "heif"
        ],
        "name": "LumenImage",
        "description": "Image",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  }
}
